<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/glass_white_focused" />
            <stroke android:width="2dp" android:color="@color/glass_white_focused_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/glass_white_default" />
            <stroke android:width="1dp" android:color="@color/glass_white_border" />
        </shape>
    </item>
</selector>
