<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إعدادات الواجهة"
        android:textColor="@color/text_white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnNativeSettings"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:text="فتح إعدادات النظام الأصلية ⚙️"
        android:background="@drawable/bg_glass_card"
        android:textColor="@color/text_white"
        android:layout_marginBottom="12dp"
        android:padding="14dp"
        android:focusable="true" />

    <Button
        android:id="@+id/btnInstallApk"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:text="تثبيت تطبيق خارجي (APK)"
        android:background="@drawable/bg_glass_card"
        android:textColor="@color/text_white"
        android:layout_marginBottom="12dp"
        android:padding="14dp"
        android:focusable="true" />
</LinearLayout>
